{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=data/app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Application": "Information",
      "Microsoft": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Application": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "DataInitialization": {
    "ClearFiles": false,
    "DropDatabase": false,
    "MigrateDatabase": false,
    "CreateDatabase": false
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  }
}
