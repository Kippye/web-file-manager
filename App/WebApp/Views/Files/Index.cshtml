@using Application.Base
@model IEnumerable<WebApp.Models.FileInfoViewModel>
@{
    ViewData["Title"] = "Files";

    (string, string) GetFileTypeIconAndName(string filename, string mimeType)
    {
        FileCategory category = BaseFileValidator.GetFileCategory(filename, mimeType);

        switch (category)
        {
            case FileCategory.Archive:
                return ("file-earmark-zip.svg", "Archive");
            case FileCategory.Audio:
                return ("file-earmark-music.svg", "Audio");
            case FileCategory.Binary:
                return ("file-earmark-binary.svg", "Binary");
            case FileCategory.Code:
                return ("file-earmark-code.svg", "Code");
            case FileCategory.Document:
                return ("file-earmark-richtext.svg", "Document");
            case FileCategory.Image:
                return ("file-earmark-image.svg", "Image");
            case FileCategory.PDF:
                return ("file-earmark-pdf.svg", "PDF");
            case FileCategory.Presentation:
                return ("file-earmark-slides.svg", "Presentation");
            case FileCategory.Spreadsheet:
                return ("file-earmark-bar-graph.svg", "Spreadsheet");
            case FileCategory.Text:
                return ("file-earmark-text.svg", "Text");
            case FileCategory.Video:
                return ("file-earmark-play.svg", "Video");

            default:
                return ("file-earmark.svg", "File");
        }
    }
}

<div class="text-center">
    <h1 class="display-4">Your files</h1>
    <p><a asp-action="Upload"">Upload some files</a></p>
    <div class = " row justify-content-center">
        <div asp-validation-summary=" All" class=" col-8 text-danger">
        </div>
    </div>
    <table class="table table-sm table-hover file-table w-100 align-middle">
        <thead>
            <th class="filename">
                Name
            </th>
            <th class="fit">
                Size
            </th>
            <th class="fit">
                Uploaded
            </th>
            <th class="fit">
                
            </th>
        </thead>
        <tbody>
            @foreach (var fileInfo in Model)
            {
                (string iconFile, string fileTypeName) = GetFileTypeIconAndName(fileInfo.FileName, fileInfo.ContentType);
                <tr>
                    <td class="filename">
                        <div class="row gx-1 flex-nowrap">
                            <div class="col-auto">
                                <img src="/assets/@iconFile" btn-primary alt="@fileTypeName" title="@fileTypeName" width="24"
                                     height="24">
                            </div>
                            <div class="col text-start">
                                <div class="text-truncate text-primary-emphasis" title="@fileInfo.FileName">
                                    @fileInfo.FileName
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="fit">
                        @fileInfo.FileSize.AsFileSize()
                    </td>
                    <td class="fit">
                        <span class="local-datetime" title="@(fileInfo.UploadedAtUtc.ToUtcString())"
                              data-utc="@(fileInfo.UploadedAtUtc.ToUtcString())">
                            @fileInfo.UploadedAtUtc.ToUtcString()
                        </span>
                    </td>
                    <td class=" fit">
                        <span>
                            <a asp-action="Download" asp-route-id=@fileInfo.Id.ToString()
                               class="button-download-icon btn btn-sm btn-light" title="Download">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="blue"
                                     class="bi bi-download" viewBox="0 0 16 16">
                                    <path
                                    d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5" />
                                    <path
                                    d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z" />
                                </svg>
                            </a>
                            <a asp-action="Delete" asp-route-id=@fileInfo.Id.ToString()
                               class="button-delete-icon btn btn-sm btn-light" title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="rgb(230, 35, 35)"
                                     class="bi bi-file-earmark-break-fill" viewBox="0 0 16 16">
                                    <path
                                    d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V9H2V2a2 2 0 0 1 2-2m5.5 1.5v2a1 1 0 0 0 1 1h2zM2 12h12v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zM.5 10a.5.5 0 0 0 0 1h15a.5.5 0 0 0 0-1z" />
                                </svg>
                            </a>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
