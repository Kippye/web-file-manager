@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">@(Model.Message ?? "Error.")</h1>
<h2 class="text-danger">@(Model.Details ?? "An error occurred while processing your request.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

